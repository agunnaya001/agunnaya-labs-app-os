# Base Mainnet RPC Endpoint
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# WalletConnect Project ID (required for multi-wallet support)
# Get your ID from: https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Optional: The Graph API endpoint for subgraph queries
NEXT_PUBLIC_GRAPH_ENDPOINT=https://api.thegraph.com/subgraphs/name/uniswap/uniswap-v3

# Optional: BaseScan API key for advanced block explorer queries
BASESCAN_API_KEY=your_basescan_api_key

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id
